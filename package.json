{
  "name": "skiller-web",
  "version": "0.2.15",
  "description": "A web microservice for managing AI agent skills across Claude Code, Cursor, Copilot, Gemini CLI, and more",
  "license": "MIT",
  "author": {
    "name": "Skiller Contributors",
    "email": "alex.elizarov1@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ProverCoderAI/skiller-web"
  },
  "type": "module",
  "main": "out/server/index.js",
  "scripts": {
    "dev": "sh -c 'bun run dev:server & server=$!; bun run dev:client; status=$?; kill $server 2>/dev/null || true; exit $status'",
    "dev:server": "bun --watch src/server/index.ts",
    "dev:client": "vite --host 127.0.0.1 --port 5180",
    "build": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit && vite build && bun build src/server/index.ts --target=node --packages external --outdir=out/server",
    "start": "node out/server/index.js",
    "preview": "SKILLER_STATIC_DIR=out/renderer node out/server/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "bun test src/shared/skill-footprint.test.ts src/mainview/lib/docker-git-launch-params.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@iarna/toml": "^2.2.5",
    "@lobehub/icons": "^5.0.1",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-virtual": "^3.13.23",
    "@trpc/client": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "@types/bun": "^1.3.12",
    "better-sqlite3": "^12.9.0",
    "cheerio": "^1.2.0",
    "chokidar": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "handlebars": "^4.7.9",
    "i18next": "^25.8.19",
    "lucide-react": "^0.577.0",
    "posthog-js": "^1.370.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-i18next": "^16.5.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.0.8",
    "simple-git": "^3.35.2",
    "siphash": "^1.2.0",
    "tailwind-merge": "^3.5.0",
    "toml": "^4.1.1",
    "tw-animate-css": "^1.4.0",
    "which": "^6.0.1",
    "yaml": "^2.8.3",
    "zod": "^3.24.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@trpc/react-query": "^11.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/handlebars": "^4.1.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/three": "^0.183.1",
    "@types/which": "^3.0.4",
    "@vitejs/plugin-react": "^4.6.0",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
